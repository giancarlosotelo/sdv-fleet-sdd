{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fleet/telemetry/1",
  "title": "Van telemetry, published at 1 Hz wall-clock on fleet/<vehicle_id>/telemetry",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "msg_id", "vehicle_id", "sim_ts", "wall_ts",
               "lat", "lon", "speed_kmh", "accel_ms2", "traction_active", "soc_pct",
               "coolant_c", "odometer_km", "trip"],
  "properties": {
    "kind": {"const": "telemetry"},
    "schema_version": {"const": 1},
    "msg_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "vehicle_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "sim_ts": {"type": "number", "minimum": 0, "description": "seconds since simulation start"},
    "wall_ts": {"type": "integer", "minimum": 0, "description": "UTC epoch milliseconds"},
    "lat": {"type": "number", "minimum": -90, "maximum": 90},
    "lon": {"type": "number", "minimum": -180, "maximum": 180},
    "speed_kmh": {"type": "number", "minimum": 0},
    "accel_ms2": {"type": "number", "description": "longitudinal; negative is braking"},
    "traction_active": {"type": "boolean"},
    "soc_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "coolant_c": {"type": "number"},
    "odometer_km": {"type": "number", "minimum": 0},
    "trip": {"type": "integer", "minimum": 1}
  }
}
