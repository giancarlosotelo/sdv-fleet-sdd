# Custom VSS overlay: fleet and hazard signals that standard VSS 4.0 doesn't have (spec REQ-040).

Vehicle.Fleet:
  type: branch
  description: Fleet operation and hazard detection signals.

Vehicle.Fleet.TripNumber:
  datatype: uint32
  type: sensor
  description: Current trip; a trip is one full loop of the van's route.

Vehicle.Fleet.SimTime:
  datatype: double
  type: sensor
  unit: s
  description: Simulation time since start.

Vehicle.Fleet.Hazard:
  type: branch
  description: Most severe current hazard, written by the hazard detector.

Vehicle.Fleet.Hazard.Type:
  datatype: string
  type: sensor
  allowed: [none, harsh_braking, traction_loss, overheat, low_energy, overspeed]
  description: Hazard type, or none.

Vehicle.Fleet.Hazard.Severity:
  datatype: uint8
  type: sensor
  min: 0
  max: 3
  description: 0 none, 1 warning, 2 high, 3 critical.

Vehicle.Fleet.Hazard.T0:
  datatype: uint64
  type: sensor
  unit: ms
  description: UTC epoch milliseconds when the current hazard was detected.
